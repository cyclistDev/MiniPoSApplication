<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.terminal.TerminalActivity"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2E3A9F" />

        <!--Hero Illustration-->
        <ImageView
            android:id="@+id/ic_login_logo"
            android:layout_width="160dp"
            android:layout_height="100dp"
            android:layout_marginTop="60dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_terminal_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"
            android:text="@string/select_company_title"
            android:textColor="#1A1A1A"
            android:textSize="22sp"
            android:textStyle="bold"
            />


        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="@string/select_company_subtitle"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            />

        <!--Company ListDropDown-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCompany"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:boxBackgroundColor="#F5F5F5"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#F5F5F5"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false">


            <AutoCompleteTextView
                android:id="@+id/actvCompany"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/hint_select_company"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ⑥ Terminal dropdown ──────────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTerminal"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="#F5F5F5"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#F5F5F5"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false">
            <AutoCompleteTextView
                android:id="@+id/actvTerminal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/hint_select_terminal"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/btn_connect"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_connect_selector"
            app:cornerRadius="12dp" />


        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>